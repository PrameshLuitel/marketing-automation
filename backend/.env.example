# ═══════════════════════════════════════════════
#  Marketing Automation — Environment Variables
#  GROQ-ONLY Configuration
# ═══════════════════════════════════════════════

# Groq API Key (single LLM provider)
GROQ_API_KEY=your-groq-api-key

# Groq Model Tiers
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_BALANCED=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_POWER=llama-3.3-70b-versatile

# Groq Rate Limit Config
GROQ_DAILY_LIMIT=14000
GROQ_RATE_LIMIT_COOLDOWN=5

# Notification Channels (all optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
NOTIFICATION_EMAIL_TO=team@example.com

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=your-chat-id

# Scheduler
SCHEDULER_TIMEZONE=UTC
SCRAPE_HOUR=2

# App Settings
DATABASE_URL=sqlite+aiosqlite:///./data/marketing.db
CHROMA_PERSIST_DIR=./data/chroma
OUTPUT_DIR=./data/outputs
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Rate Limits
MAX_ITEMS_PER_PLATFORM=200
SCRAPE_DELAY_SECONDS=2
